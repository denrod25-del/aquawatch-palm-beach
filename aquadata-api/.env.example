# Required
DATABASE_URL=postgresql://aquadata:CHANGE-ME@127.0.0.1:5432/aquadata
REDIS_URL=redis://127.0.0.1:6379/0

# Optional — leave unset to disable Stripe pushes (usage still records in
# api.usage and reconciles once the key is configured)
#STRIPE_API_KEY=sk_live_...
# Required for paid signup: webhook signing secret for /v1/stripe/webhook
# and the pages Checkout returns to (both must be https)
#STRIPE_WEBHOOK_SECRET=whsec_...
#CHECKOUT_SUCCESS_URL=https://example.com/thanks
#CHECKOUT_CANCEL_URL=https://example.com/pricing

# Optional overrides (defaults shown)
#CACHE_TTL_SECONDS=86400
#STRIPE_BATCH_SECONDS=60
