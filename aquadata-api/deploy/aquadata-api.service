[Unit]
Description=AquaData API (uvicorn)
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
User=aquadata
Group=aquadata
WorkingDirectory=/opt/aquadata/app/aquadata-api
EnvironmentFile=/opt/aquadata/env
ExecStart=/opt/aquadata/venv/bin/uvicorn aquadata.api.main:app \
    --host 127.0.0.1 --port 8500 --workers 4 \
    --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=2
# Graceful stop lets the usage buffer and Stripe batcher drain.
TimeoutStopSec=15
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
